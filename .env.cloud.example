# Copy to .env on the server; keep real credentials out of GitHub.
PUBLIC_IP=REPLACE_WITH_SERVER_PUBLIC_IPV4
CADDY_CONFIG=Caddyfile.bootstrap
PERSONAL_HUB_PUBLIC_DATA_DIR=/var/lib/personalhub
PERSONAL_HUB_PUBLIC_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
# Enable only after checking this exact model's free quota and expiry in Beijing.
PERSONAL_HUB_CLOUD_AI_ENABLED=false
# This confirms a CONSOLE setting. It does not itself change Alibaba billing.
PERSONAL_HUB_FREE_ONLY_CONFIRMED=false
