{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "semi": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "embeddedLanguageFormatting": "off",
  "overrides": [
    {
      "files": "*.wxss",
      "options": {
        "parser": "css"
      }
    }
  ]
}
