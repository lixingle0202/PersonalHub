@import "../styles/icons.wxss";

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  display: flex;
  align-items: stretch;
  border-top: 1rpx solid #e9edf6;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -6rpx 30rpx rgba(30, 42, 74, 0.06);
  transition: transform 0.22s ease;
}

/* 弹层打开时收起，给弹层底部的保存按钮让位 */
.tabbar-hidden {
  transform: translateY(120%);
}

.tab {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 14rpx 2rpx 12rpx;
  height: 106rpx;
}

.tab-ic {
  width: 42rpx;
  height: 42rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.tab-text {
  font-size: 19rpx;
  letter-spacing: -0.4rpx;
  white-space: nowrap;
}

.tab.on .tab-text {
  font-weight: 600;
}

/* 角标：包一层相对定位，红点挂在图标右上角 */
.tab-ic-wrap {
  position: relative;
  width: 42rpx;
  height: 42rpx;
}

.tab-ic-wrap .tab-ic {
  display: block;
}

.tab-badge {
  position: absolute;
  top: -10rpx;
  right: -18rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #e5484d;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}
