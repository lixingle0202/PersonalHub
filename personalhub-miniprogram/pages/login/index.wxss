.login {
  padding: calc(var(--sb, 0px) + 40rpx) 20rpx 60rpx;
  min-height: 100vh;
}

.login-wrap {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding-top: 60rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 0 8rpx;
}

.brand-txt {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.brand-name {
  font-size: 36rpx;
  font-weight: 650;
  letter-spacing: -1rpx;
}

.brand-caption {
  font-size: 22rpx;
  color: var(--text-2);
  letter-spacing: 2rpx;
}

.login-card {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  padding: 44rpx 36rpx 36rpx;
  border-radius: 32rpx;
}

.intro {
  margin-top: -6rpx;
  margin-bottom: 6rpx;
}

.login-error {
  align-items: center;
}

.pwd-wrap {
  position: relative;
}

.pwd-input {
  padding-right: 110rpx;
}

.pwd-eye {
  position: absolute;
  right: 22rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 8rpx;
}

.login-btn {
  margin-top: 8rpx;
  height: 88rpx;
  font-size: 28rpx;
}

.agree-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 2rpx 0;
}

.agree-box {
  width: 30rpx;
  height: 30rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--line, #e4e8f2);
  background: var(--surface, #ffffff);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.agree-box.on {
  background: var(--primary);
  border-color: var(--primary);
}

.agree-text {
  color: var(--text-2);
}

.agree-link {
  color: var(--primary-readable);
  text-decoration: underline;
}

.input-readonly {
  display: flex;
  align-items: center;
  word-break: break-all;
  background: rgba(120, 130, 160, 0.08);
}

.switch-row {
  display: flex;
  justify-content: center;
  padding: 6rpx 0;
}

.login-foot {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding-top: 10rpx;
  text-align: center;
  word-break: break-all;
}
