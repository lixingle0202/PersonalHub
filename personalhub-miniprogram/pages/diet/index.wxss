.mark-sm {
  width: 64rpx;
  height: 64rpx;
  font-size: 36rpx;
  border-radius: 20rpx;
}

.retry-btn {
  margin-top: 20rpx;
}

.tabs {
  margin: 6rpx 0 20rpx;
}
.tabs .segment-item {
  font-size: 22rpx;
  padding: 14rpx 2rpx;
}

/* ---------------- 日历 ---------------- */
.calendar-card {
  padding: 24rpx 20rpx 20rpx;
}

.cal-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 4rpx 16rpx;
}

.cal-nav {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: var(--surface-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
}

.flip {
  transform: rotate(180deg);
}

.cal-title {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: -0.4rpx;
}

.week-head {
  display: flex;
  padding-bottom: 8rpx;
}

.week-cell {
  width: 14.2857%;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-3);
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  width: 14.2857%;
  min-height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 4rpx;
  padding: 10rpx 2rpx 8rpx;
  border-radius: 16rpx;
  border: 1rpx solid transparent;
  position: relative;
}

.cell.other .cell-day {
  color: var(--text-3);
  opacity: 0.5;
}
.cell.other .cell-kcal {
  opacity: 0.4;
}

.cell.sel {
  background: var(--primary-soft);
  border-color: var(--primary-tint);
}

.cell.today .cell-day {
  color: #fff;
  background: var(--primary);
  border-radius: 999rpx;
  min-width: 40rpx;
  text-align: center;
  padding: 0 6rpx;
}

.cell-day {
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.5;
}

.cell-dots {
  display: flex;
  gap: 4rpx;
  height: 12rpx;
  align-items: center;
}

.mdot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex: none;
}

.mdot-breakfast {
  background: #e8a33a;
}
.mdot-lunch {
  background: #2f9d6f;
}
.mdot-dinner {
  background: #5b6cff;
}
.mdot-snack {
  background: #a15ddb;
}

.cell-kcal {
  font-size: 17rpx;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.legend {
  display: flex;
  gap: 22rpx;
  padding: 14rpx 6rpx 2rpx;
  border-top: 1rpx solid var(--line);
  margin-top: 8rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

/* ---------------- 当天餐次 ---------------- */
.day-sum {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 4rpx 0 8rpx;
}

.day-sum-num {
  font-size: 40rpx;
  font-weight: 650;
  letter-spacing: -1.2rpx;
  color: var(--primary-readable);
}

.day-meal {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 18rpx;
  border-radius: 18rpx;
  background: var(--surface-subtle);
}

.meal-type-tag {
  width: 8rpx;
  height: 48rpx;
  border-radius: 4rpx;
  flex: none;
}

.meal-name {
  font-size: 27rpx;
  font-weight: 600;
}

.meal-sub {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  margin-top: 4rpx;
}

/* ---------------- 菜品 / 清单 ---------------- */
.tab-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 4rpx 0 16rpx;
}

.dish-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 26rpx;
}

.dish-name {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 4rpx;
}

.dish-note {
  display: block;
  margin-bottom: 4rpx;
}

.dish-del {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.65;
  flex: none;
}

.dish-edit {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.6;
  flex: none;
  margin-right: 4rpx;
}

.dish-row:active {
  background: var(--primary-soft);
}

.dish-sheet-del {
  margin-top: 28rpx;
  color: #c9455a;
}

.sug-empty {
  padding: 4rpx 4rpx 0;
  color: var(--text-3, #939bad);
}

.shop-card {
  margin-bottom: 16rpx;
}

.shop-items {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.shop-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 0;
}

.shop-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.shop-qty {
  flex: none;
}

.shop-edit {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 4rpx 0;
}

.shop-edit .input {
  min-height: 66rpx;
  font-size: 26rpx;
}

.shop-edit-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.shop-edit-row .btn {
  flex: none;
}

/* 行内图标点按区域放大一点，方便手指点 */
.shop-item .dish-edit,
.shop-item .dish-del {
  width: 56rpx;
  height: 56rpx;
}

.checkbox.small {
  width: 36rpx;
  height: 36rpx;
  border-radius: 11rpx;
}

.shop-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
}

.shop-name.done {
  color: var(--text-3);
  text-decoration: line-through;
}

.shop-add {
  display: flex;
  gap: 10rpx;
  align-items: center;
  margin-top: 14rpx;
}

/* ---------------- 每日记录 ---------------- */
.water-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 8rpx 0 20rpx;
}

.water-value {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.water-num {
  font-size: 50rpx;
  font-weight: 650;
  letter-spacing: -2rpx;
  color: var(--primary-readable);
}

.water-actions {
  display: flex;
  gap: 8rpx;
}

.field-row {
  display: flex;
  gap: 16rpx;
}
.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.save-btn {
  margin-top: 8rpx;
}

.body-hint {
  display: block;
  margin-bottom: 16rpx;
}

.notes-input {
  min-height: 100rpx;
}

.dish-scroll {
  padding: 4rpx 0;
}

.big-empty {
  margin-top: 30rpx;
  gap: 16rpx;
}

/* AI 生成菜单（与学习页共用类名约定） */
.ai-plan-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 4rpx 4rpx 12rpx;
}

.ai-plan-name {
  font-size: 30rpx;
  font-weight: 650;
}

.ai-plan-meta {
  color: var(--text-2);
}

.ai-day {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--line, #e4e8f2);
}

.ai-day-date {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary-readable);
}

.ai-task {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  background: rgba(120, 130, 160, 0.07);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
}

.ai-task-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ai-task-type {
  color: var(--primary-readable);
  background: rgba(120, 130, 160, 0.12);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.ai-task-title {
  font-size: 26rpx;
  font-weight: 550;
}

.ai-task-min {
  color: var(--text-2);
}

/* ---------------- 一餐多菜 + 热量预估 ---------------- */
.dish-line {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.dish-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.dish-input {
  padding-right: 62rpx;
}

.dish-input-wrap .dish-del {
  position: absolute;
  right: 10rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: rgba(120, 130, 160, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--text-3);
  opacity: 1;
}

.sug-box {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(41, 60, 101, 0.08);
}

.sug-item {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.sug-item:last-child {
  border-bottom: none;
}

.sug-item:active {
  background: var(--primary-soft);
}

.sug-name {
  font-size: 26rpx;
  font-weight: 550;
  color: var(--text);
  flex: none;
}

.sug-detail {
  font-size: 21rpx;
  color: var(--text-3);
  flex: 1;
  min-width: 0;
}

.add-dish {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  align-self: flex-start;
  margin-top: 6rpx;
  padding: 14rpx 22rpx;
  border-radius: 14rpx;
  border: 1rpx dashed var(--primary-tint);
  background: var(--primary-soft);
  color: var(--primary-readable);
  font-size: 24rpx;
}

.add-dish-plus {
  font-size: 28rpx;
  line-height: 1;
}

.est-card {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  background: var(--surface-subtle);
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
}

.est-title {
  font-size: 23rpx;
  color: var(--text-2);
}

.est-total {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.est-num {
  font-size: 46rpx;
  font-weight: 650;
  letter-spacing: -1.4rpx;
  color: var(--primary-readable);
  line-height: 1.2;
}

.est-unit {
  font-size: 21rpx;
  color: var(--text-3);
}

.est-items {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 8rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid var(--line);
}

.est-item {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.est-item-name {
  font-size: 23rpx;
  color: var(--text-2);
  flex: 1;
  min-width: 0;
}

.est-item-kcal {
  font-size: 23rpx;
  color: var(--text-2);
  flex: none;
}

.est-note {
  line-height: 1.55;
  margin-top: 4rpx;
}

.est-warn {
  color: var(--amber);
  line-height: 1.5;
}

.meal-add {
  flex: none;
  margin-left: 6rpx;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background: var(--primary-soft);
  color: var(--primary-readable);
  font-size: 21rpx;
  line-height: 1.35;
}

.field-hint {
  flex: none;
  white-space: nowrap;
}

/* ============ 照片记录 ============ */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.photo-cell {
  width: calc((100% - 28rpx) / 3);
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo-thumb {
  width: 100%;
  height: 100%;
  background: var(--surface-subtle);
}

.photo-add {
  width: calc((100% - 28rpx) / 3);
  aspect-ratio: 1;
  border: 2rpx dashed var(--line);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: var(--text-3);
}

.photo-add-plus {
  font-size: 48rpx;
  line-height: 1;
  color: var(--text-3);
}

.photo-tip {
  display: block;
  margin-top: 14rpx;
}

/* ============ 批量添加（语音 + 文本） ============ */
.voice-btn {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary-readable);
  font-size: 24rpx;
}

.voice-btn.rec {
  background: var(--danger-soft);
  color: var(--danger);
  animation: voice-pulse 1.1s ease-in-out infinite;
}

@keyframes voice-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.55;
  }
}

/* ============ 每日记录的日期切换 ============ */
.day-head {
  gap: 10rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.day-nav {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-subtle);
  border: 1rpx solid var(--line);
}

.day-nav-ic {
  font-size: 38rpx;
  line-height: 1;
  color: var(--text-2);
}

.day-picker {
  flex: none;
  max-width: 420rpx;
}

.day-pick {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  border: 1rpx solid transparent;
}

.day-pick.past {
  background: rgba(232, 129, 58, 0.14);
  border-color: rgba(232, 129, 58, 0.35);
}

.day-pick.future {
  background: var(--surface-subtle);
  border-color: var(--line);
}

.day-pick-text {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  color: var(--primary-readable);
}

.day-pick.past .day-pick-text {
  color: #c96a26;
}

.day-pick.future .day-pick-text {
  color: var(--text-2);
}

.day-pick-tag {
  flex: none;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.5;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  color: var(--primary-readable);
  background: rgba(255, 255, 255, 0.75);
}

.day-pick-tag.past {
  color: #fff;
  background: #e8813a;
}

.day-pick-tag.future {
  color: var(--text-2);
  background: var(--surface);
}

.day-today {
  flex: none;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--primary-readable);
  padding: 8rpx 18rpx;
  border: 1rpx solid var(--primary);
  border-radius: 999rpx;
  background: var(--primary-soft);
}

/* 非今天时的醒目提示条 */
.day-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  margin: 0 0 16rpx;
  border-radius: 16rpx;
  background: var(--primary-soft);
  border: 1rpx solid rgba(232, 129, 58, 0.35);
}

.day-banner.past {
  background: rgba(232, 129, 58, 0.14);
}

.day-banner.future {
  background: var(--surface-subtle);
  border-color: var(--line);
}

.day-banner-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e8813a;
}

.day-banner.future .day-banner-dot {
  background: var(--text-3);
}

.day-banner-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.day-banner-act {
  flex: none;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--primary-readable);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--surface);
}

/* 每日记录：当天饮水/体重摘要 */
.day-brief {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 18rpx 24rpx;
  margin: 0 0 4rpx;
  background: var(--surface-subtle);
  border-radius: 20rpx;
}

.day-brief-item {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  flex: none;
}

.day-brief-k {
  font-size: 21rpx;
  color: var(--text-2);
}

.day-brief-v {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.day-brief-u {
  font-size: 19rpx;
  font-weight: 400;
  color: var(--text-3);
  margin-left: 2rpx;
}

.day-brief-feel {
  flex: 1;
  min-width: 0;
  text-align: right;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ============ 每日记录右上角日期胶囊 ============ */
.health-date-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.health-date-picker {
  flex: none;
}

.health-date {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  border: 1rpx solid transparent;
}

.health-date.past {
  background: rgba(232, 129, 58, 0.16);
  border-color: rgba(232, 129, 58, 0.4);
}

.health-date.future {
  background: var(--surface-subtle);
  border-color: var(--line);
}

.health-date-text {
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  color: var(--primary-readable);
}

.health-date.past .health-date-text {
  color: #c96a26;
}

.health-date.future .health-date-text {
  color: var(--text-2);
}

.health-date-tag {
  flex: none;
  font-size: 20rpx;
  font-weight: 650;
  line-height: 1.5;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  color: var(--primary-readable);
  background: rgba(255, 255, 255, 0.78);
}

.health-date.past .health-date-tag {
  color: #fff;
  background: #e8813a;
}

.health-date.future .health-date-tag {
  color: var(--text-2);
  background: var(--surface);
}

.health-back-today {
  flex: none;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--primary-readable);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  border: 1rpx solid var(--primary);
}
