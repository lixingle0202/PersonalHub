.date-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 6rpx 0 4rpx;
}

.date-nav {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-soft);
  flex: none;
}

.date-nav:active {
  background: var(--primary-tint);
}

.date-arrow {
  width: 32rpx;
  height: 32rpx;
}

.date-arrow.flip {
  transform: rotate(180deg);
}

.date-center {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 0 6rpx;
}

.date-text {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.6rpx;
}

.back-today {
  display: flex;
  justify-content: center;
  padding: 12rpx 0 0;
}

.back-today .tiny {
  color: var(--primary-readable);
  background: var(--primary-soft);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

/* 分组 */
.group {
  margin-top: 26rpx;
}

.group-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 6rpx 12rpx;
}

.group-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-2);
  letter-spacing: 0.4rpx;
}

.group-count {
  font-size: 21rpx;
  color: var(--text-3);
  background: var(--surface-subtle);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}

.group-card {
  padding: 6rpx 26rpx;
}

.agenda-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.agenda-row:last-child {
  border-bottom: none;
}

.agenda-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.agenda-line {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.agenda-title {
  font-size: 28rpx;
  line-height: 1.45;
  flex: 1;
  min-width: 0;
}

.agenda-title.done {
  color: var(--text-3);
  text-decoration: line-through;
}

.agenda-sub {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.row-tag {
  flex: none;
  margin-top: 2rpx;
}

.tiny-tag {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
}

.notes-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 380rpx;
}

.row-more {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  opacity: 0.7;
}

.big-empty {
  margin-top: 30rpx;
  gap: 16rpx;
}

/* 表单 */
.field-row {
  display: flex;
  gap: 16rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip-row .chip {
  margin-right: 0;
}

.notes-input {
  min-height: 120rpx;
}

.end-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.end-title {
  font-size: 26rpx;
  line-height: 1.5;
}

.end-segment .segment-item {
  font-size: 22rpx;
  padding: 12rpx 4rpx;
}
