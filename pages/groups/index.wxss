.back-btn {
  flex: none;
  margin-right: 8rpx;
}

.back-ic {
  font-size: 36rpx;
  line-height: 1;
  color: var(--text-2);
}

/* 未开通引导 */
.cloud-steps {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 18rpx 0 16rpx;
  padding: 20rpx 22rpx;
  background: var(--surface-subtle);
  border-radius: 18rpx;
}

.cloud-steps .step {
  font-size: 23rpx;
  line-height: 1.65;
  color: var(--text-2);
}

.cloud-tip {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 23rpx;
  line-height: 1.6;
}

/* 昵称 */
.name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 18rpx;
}

/* 群列表 */
.group-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 26rpx 0;
}

.group-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line);
}

.group-row:first-of-type {
  border-top: none;
}

.group-avatar {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--primary-soft);
  color: var(--primary-readable);
  font-size: 32rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
}

.group-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.group-name {
  display: block;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 4rpx;
}

.group-arrow {
  flex: none;
  font-size: 36rpx;
  color: var(--text-3);
  line-height: 1;
}

/* 底部操作 */
.group-actions {
  display: flex;
  gap: 16rpx;
}

/* 邀请码输入 */
.code-input {
  text-align: center;
  font-size: 38rpx;
  font-weight: 650;
  letter-spacing: 10rpx;
  padding-left: 10rpx;
}

/* 「部署好了，重新检测」 */
.retry-btn {
  margin-top: 22rpx;
  font-size: 26rpx;
}

/* 引导卡里的报错条 */
.guide-err {
  margin: 16rpx 0 6rpx;
}
